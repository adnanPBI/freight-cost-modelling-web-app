{
  "name": "carrier-rate-allocation-platform",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm audit --omit=dev --audit-level=high && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && tsx prisma/seed.ts",
    "verify:samples": "vitest run tests/importers.test.ts",
    "audit:security": "npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12",
    "@ayocore/exceljs": "5.0.4",
    "@aws-sdk/client-s3": "3.1146.0",
    "readable-stream": "4.7.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "deepmerge-ts": "8.0.2"
  }
}
